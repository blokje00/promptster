# Base44 Configuration
VITE_BASE44_APP_ID=68f4bcd57ca6479c7acf2f47
VITE_BASE44_SERVER_URL=https://base44.app

# Optional: Voor service role operaties
# VITE_BASE44_SERVICE_TOKEN=your-service-token-here

# Optional: Voor testing met specifieke user token
# VITE_BASE44_AUTH_TOKEN=your-test-user-token

# Backend-only secrets: set these in the Base44 dashboard (Secrets), never in this repo.
# Read by base44/functions/utils/nousLLM/entry.ts:
#   nousresearch        (required) Nous Research API key (NOUS_API_KEY works as an alias)
#   NOUS_API_BASE_URL   (optional) default https://inference-api.nousresearch.com/v1
#   NOUS_TEXT_MODEL     (optional) default deepseek/deepseek-v4-flash-0731
#   NOUS_VISION_MODEL   (optional) default deepseek/deepseek-v4-flash-vision-exp
