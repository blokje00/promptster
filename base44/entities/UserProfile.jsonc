{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 Auth User ID (koppeling)"
    },
    "email": {
      "type": "string",
      "description": "Email kopie voor snelle lookup"
    },
    "subscription_status": {
      "type": "string",
      "description": "Abonnementsstatus (kopie voor admin-statistieken)"
    },
    "plan_id": {
      "type": "string",
      "description": "ID van het huidige plan"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Einde van de proefperiode"
    }
  },
  "required": [
    "user_id",
    "email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}