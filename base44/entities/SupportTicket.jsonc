{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "payment",
        "feature",
        "other"
      ],
      "description": "Categorie van het support verzoek"
    },
    "subject": {
      "type": "string",
      "description": "Onderwerp van het verzoek"
    },
    "message": {
      "type": "string",
      "description": "Volledige beschrijving"
    },
    "user_email": {
      "type": "string",
      "description": "Email van de gebruiker"
    },
    "user_name": {
      "type": "string",
      "description": "Naam van de gebruiker"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Status van het ticket"
    }
  },
  "required": [
    "category",
    "subject",
    "message"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}